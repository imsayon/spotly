{
  "name": "@spotly/server",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit",
    "db:generate": "pnpm --filter @spotly/database exec prisma generate",
    "db:migrate": "pnpm --filter @spotly/database db:migrate",
    "test": "pnpm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.28",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@spotly/database": "workspace:*",
    "@spotly/types": "workspace:*",
    "@supabase/supabase-js": "2.110.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "helmet": "8.3.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "prisma": "7.9.0",
    "typescript": "5.8.3"
  }
}
