# ─── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm (pinned stable version)
RUN npm install -g pnpm@9.15.9 --no-audit --no-update-notifier

# ── Copy shared packages ──
COPY packages/types ./packages/types
COPY packages/ui ./packages/ui

# ── Build packages/types ──
WORKDIR /app/packages/types
RUN pnpm install --frozen-lockfile
RUN pnpm build

# ── Build packages/ui ──
WORKDIR /app/packages/ui
RUN pnpm install --frozen-lockfile
RUN pnpm build

# ── Install & build merchant-client ──
WORKDIR /app/merchant-client
COPY merchant-client/package.json merchant-client/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY merchant-client/ .

# Disable Next.js telemetry in CI
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

# ─── Stage 2: Runner ──────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy built Next.js standalone output
COPY --from=builder --chown=nextjs:nodejs /app/merchant-client/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/merchant-client/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/merchant-client/public ./public

USER nextjs

EXPOSE 3002

ENV PORT=3002
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:3002/ || exit 1

CMD ["node", "server.js"]
